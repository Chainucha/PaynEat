# ---- Server ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---- Database (SQLite) ----
DATABASE_FILE=data/payneat.sqlite

# ---- สำรองข้อมูลอัตโนมัติ (ดู docs/tickets/33-automatic-backup.md และคู่มือติดตั้ง หัวข้อสำรองและกู้คืนข้อมูล) ----
# เซิร์ฟเวอร์สำรองเองหลังปิดกะ, ทุก 6 ชั่วโมงเมื่อมีข้อมูลเปลี่ยน, ก่อนอัปเดตฐานข้อมูล และเมื่อ admin กด "สำรองข้อมูลตอนนี้"
# กู้คืน: หยุดเซิร์ฟเวอร์ก่อน แล้วรัน  npm run db:restore -- data/backups/<ชื่อไฟล์>.sqlite
#
# ที่เก็บชุดแรก — ค่าเริ่มต้นคือ backups/ ข้างไฟล์ฐานข้อมูล (data/backups) ห้ามอยู่ในโฟลเดอร์ที่เว็บเสิร์ฟ (docs/, app/web)
# เซิร์ฟเวอร์ไม่ยอมเริ่มถ้าตั้งผิด เพราะไฟล์สำรองมีเบอร์โทรลูกค้าและ hash รหัสผ่าน
# BACKUP_DIR=data/backups
# ที่เก็บชุดที่สอง (ไม่บังคับ แต่แนะนำ) — ควรเป็นอีกดิสก์ เช่น USB drive หรือโฟลเดอร์บน NAS ในร้าน
# ชุดแรกอยู่ดิสก์เดียวกับฐานข้อมูล ดิสก์เสียครั้งเดียวจะเสียทั้งคู่ ชุดที่สองล้มเหลวแยกจากชุดแรกและแสดงสถานะแยกกัน
# BACKUP_COPY_DIR=/mnt/usb-backup/payneat      (Windows: E:\PaynEat-backup)
# เก็บไฟล์ล่าสุดของแต่ละวันย้อนหลังกี่วัน — ไฟล์ใน 48 ชั่วโมงล่าสุดเก็บทุกไฟล์ ไฟล์ก่อนอัปเดตและก่อนกู้คืนเก็บ 90 วัน
# และไม่ลบจนเหลือ 0 ไฟล์แม้ตั้ง 0
# BACKUP_KEEP_DAYS=30

# ---- Auth ----
# ค่านี้ใช้ได้เฉพาะรันในเครื่อง — NODE_ENV=production ต้องเป็นค่าสุ่มของร้านยาวอย่างน้อย 32 ตัวอักษร
# (openssl rand -hex 32) ถ้าใช้ค่าตัวอย่างหรือค่าสั้น เซิร์ฟเวอร์จะไม่ยอมเริ่มทำงาน
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=12h

# ---- CORS (คั่นหลายค่าด้วย ,) ----
CORS_ORIGIN=*

# ---- ข้อมูลร้าน (ค่าเริ่มต้น แก้ภายหลังได้ที่หน้า Settings) ----
STORE_NAME=PaynEat Restaurant
CURRENCY=THB
VAT_RATE=0.07
SERVICE_CHARGE_RATE=0.10
VAT_INCLUDED=false

# ตั้งเป็น false ถ้าไม่ต้องการให้ seed ข้อมูลตัวอย่างตอนสตาร์ต
AUTO_SEED=true

# ---- ผู้ช่วย AI ถามตอบข้อมูลร้าน (ดู docs/tickets/15-ai-ask-your-data.md) ----
# ไม่ตั้งค่า ANTHROPIC_API_KEY แปลว่าปิดฟีเจอร์นี้ไว้ (endpoint คืน 503 เฉยๆ ไม่กระทบ POS หลัก)
# ANTHROPIC_API_KEY=
AI_ASSISTANT_MODEL=claude-opus-5
# จำนวนคำถามสูงสุดต่อผู้ใช้ต่อวัน กันเรียก LLM บ่อยเกินจนเสียค่าใช้จ่ายเกินควบคุม
AI_ASSISTANT_DAILY_LIMIT=20

# ---- ส่งเอกสารลูกหนี้ (ใบวางบิล/ใบเสร็จรับชำระ/ใบลดหนี้/ใบแจ้งดอกเบี้ย) เป็น PDF ทางอีเมล ----
# ดู docs/tickets/23-document-pdf-email.md — ไม่ตั้ง SMTP_HOST = ปิดการส่งอีเมล (ปุ่มดาวน์โหลด PDF ยังใช้ได้)
# ตัวอย่าง Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 + App Password (ไม่ใช่รหัสผ่านบัญชี)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ร้านของฉัน <billing@example.com>"

# ---- ตาชั่งต่อสาย อ่านน้ำหนักสด (ดู docs/tickets/22-live-scale-camera-scan.md) ----
# off (ค่าเริ่มต้น) | tcp | serial | simulator — รองรับรูปแบบ A&D/CAS ("ST,GS,+0.485kg"), Mettler
# Toledo MT-SICS ("S S 0.485 kg") และตัวเลข+หน่วย ("0.485 kg")
# SCALE_DRIVER=off
# SCALE_TCP_HOST=192.168.1.50
# SCALE_TCP_PORT=4001
# SCALE_SERIAL_PATH=/dev/ttyUSB0   (Windows: COM3)
# SCALE_BAUD_RATE=9600
# ตาชั่งที่ต้องถามก่อนถึงจะตอบ: ตั้งคำสั่งขอน้ำหนัก เช่น MT-SICS ใช้ SI
# SCALE_POLL_COMMAND=SI
# SCALE_POLL_MS=500

# ---- log และ metric ตามสัญญา telemetry ของระบบนิเวศ PaynEat (ดู docs/tickets/24-telemetry-contract.md) ----
# log เป็น JSON บรรทัดละ object ออก stdout เสมอ (อ่านง่ายตอนพัฒนา: npm run dev --silent | jq -R 'fromjson? // .')
# LOG_LEVEL=INFO             # DEBUG | INFO | NOTICE | WARNING | ERROR | CRITICAL — DEBUG เขียน stack ของ error ด้วย
# LOG_FORMAT=default         # gcp = เฉพาะ deployment บน Google Cloud (labels/trace ไปอยู่ที่ key ของ Cloud Logging)
# GOOGLE_CLOUD_PROJECT=      # ใช้คู่กับ LOG_FORMAT=gcp เพื่อเขียน trace เป็น projects/<id>/traces/<trace>
# /metrics (Prometheus) อยู่พอร์ตของตัวเอง ไม่ใช่พอร์ต API — ห้ามเปิดพอร์ตนี้ออกเน็ต (docker compose ไม่เปิดให้อยู่แล้ว)
# METRICS_PORT=9464          # ต้องไม่ซ้ำกับ PORT
# METRICS_HOST=127.0.0.1     # ค่าเริ่มต้น = ฟังเฉพาะเครื่องนี้ — ตั้ง 0.0.0.0 เฉพาะเมื่อตัวเก็บ metric อยู่คนละเครื่องในเครือข่ายปิด

# ---- ดีบัก ----
# EXPOSE_ERROR_STACK=true    # แนบ stack ของ error 500 ไปกับคำตอบ API ตอนดีบักในเครื่อง (ไม่ทำงานเมื่อ NODE_ENV=production)

# ---- โหมดเชื่อมต่อ PaynEat ERP (ticket 25, ไม่บังคับ) ----
# ที่อยู่ ERP และ credential (pnepos_…) ตั้งที่หน้าตั้งค่าของแอป (admin → การเชื่อมต่อ) ไม่ใช่ที่นี่ — ร้านเดี่ยวไม่ต้องตั้งอะไร
# ERP_PULL_INTERVAL_SECONDS=300   # ดึง master data จาก ERP ทุกกี่วินาที (0 = ดึงเมื่อกด "ดึงทันที" เท่านั้น)
# ERP_TIMEOUT_MS=15000            # รอคำตอบของ ERP นานสุดต่อคำขอ
#
# credential ไปหา ERP ทาง https:// เท่านั้น (ticket 32) — http:// ใช้ได้เฉพาะ localhost / 127.x / [::1] ในเครื่องเดียวกัน
# ใบรับรอง HTTPS ถูกตรวจเสมอ ไม่มีค่าที่ปิดการตรวจ (ห้ามตั้ง NODE_TLS_REJECT_UNAUTHORIZED=0)
#
# ERP ของเชนใช้ใบรับรองจาก CA ภายใน: ให้เครื่อง POS เชื่อ CA นั้นด้วย NODE_EXTRA_CA_CERTS=<ไฟล์ PEM ของ CA>
# ตั้งใน environment ของ process ที่รันเซิร์ฟเวอร์ — ใส่ในไฟล์นี้ไม่ได้ผล เพราะ Node อ่านค่านี้ตอนเริ่ม ก่อนโหลด .env เช่น
#   NODE_EXTRA_CA_CERTS=/etc/payneat/chain-ca.pem npm start
# Docker: mount ไฟล์ CA เข้าคอนเทนเนอร์ api แล้วตั้งค่านี้ใน environment ของ service (คู่มือติดตั้ง หัวข้อแก้ปัญหา)
# ไม่ต้องตั้งถ้าใบรับรองออกโดย CA สาธารณะ
#
# เครือข่ายปิดเท่านั้น (เช่นเดโมที่ POS กับ ERP อยู่ใน Docker network เดียวกัน): ยอมส่ง credential ผ่าน http:// ที่ไม่ใช่
# loopback — หน้าตั้งค่าเตือนสีแดงตลอดเวลา และ log WARNING ตอนเปิดเครื่อง ห้ามตั้งในร้านที่ใช้งานจริง (SECURITY.md)
# ERP_ALLOW_INSECURE_HTTP=true

# ---- รหัสผ่านบัญชีเดโม (ใช้เฉพาะตอน NODE_ENV=production) ----
# บัญชีเดโม (admin/admin123 ฯลฯ) เผยแพร่อยู่ใน README/ซอร์สโค้ดสาธารณะ ใช้ได้เฉพาะตอนรันดู
# ในเครื่อง/เดโมเท่านั้น — ถ้า NODE_ENV=production ต้องตั้งค่าทั้ง 6 ตัวนี้เองก่อน ไม่งั้น seed
# จะ throw ปฏิเสธไม่ยอมสร้างบัญชีด้วยรหัสผ่านที่รู้กันอยู่แล้ว (ดู SECURITY.md)
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_WAITER1_PASSWORD=
# SEED_WAITER2_PASSWORD=
# SEED_KITCHEN_PASSWORD=
# SEED_CASHIER_PASSWORD=
