# .env ที่รากของ repo สำหรับเครื่องเซิร์ฟเวอร์ในร้าน — สร้างด้วย deploy/shop/init-env.sh (สุ่มรหัสลับให้) หรือคัดลอกไฟล์นี้
# docker compose อ่านไฟล์นี้เอง และ COMPOSE_FILE ทำให้ `docker compose up -d --build` ใช้ไฟล์ร้านซ้อนให้ทุกครั้ง
COMPOSE_FILE=docker-compose.yml:deploy/shop/docker-compose.shop.yml

# ที่อยู่ของเครื่องเซิร์ฟเวอร์ในวง LAN — จองไว้ที่ router (DHCP reservation) ไม่งั้นอาจเปลี่ยนหลังรีสตาร์ต
SHOP_LAN_HOST=192.168.1.10
# โดเมนที่ลูกค้าเปิดจาก QR (ต้องอยู่ใน Cloudflare และตรงกับ deploy/shop/cloudflared/config.yml)
PUBLIC_HOST=order.example.com
# จุด mount ของดิสก์สำรองชุดที่สอง (อีกดิสก์หนึ่ง) — โฟลเดอร์ payneat ข้างในต้องให้ uid 1000 เขียนได้
BACKUP_DISK_MOUNT=/mnt/backup
# BACKUP_KEEP_DAYS=30

# รหัสลับ — สุ่มเองด้วย openssl rand -hex 32 (JWT) และรหัสผ่านพนักงาน 6 บัญชี (ใช้ตอนสร้างฐานข้อมูลครั้งแรกเท่านั้น)
JWT_SECRET=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_WAITER1_PASSWORD=
SEED_WAITER2_PASSWORD=
SEED_KITCHEN_PASSWORD=
SEED_CASHIER_PASSWORD=

# ผู้ใช้บนเครื่องที่เป็นเจ้าของไฟล์ credential ของ tunnel (id -u / id -g)
# PAYNEAT_UID=1000
# PAYNEAT_GID=1000
